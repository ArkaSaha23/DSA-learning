class Solution {
    public int findMin(int[] nums) {
        int n = nums.length;

        int left = 0;
        int right = n-1;
        int ans = Integer.MAX_VALUE;

        //if a sorted halve id found take that minimum and update the left and rioght pointer...besically remove that halve from the serach space
        while(left <= right)
        {
            int mid = left + (right - left)/2;
            
            if(nums[left] <= nums[mid])
            {
                ans = Math.min(ans,nums[left]);
                left = mid+1;
            }
            else if(nums[mid] <= nums[right])
            {
                ans= Math.min(ans,nums[mid]);
                right = mid -1;               
            }
        }
        return ans;
    }
}
