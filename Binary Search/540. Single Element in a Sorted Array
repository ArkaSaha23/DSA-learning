class Solution {
    public int singleNonDuplicate(int[] nums) {
        int n=nums.length;
        int left = 0;
        int right = n-1;

        //single element array
        if(n==1){    
            return nums[0];
        }

        while( left <= right)
        {
            int mid = left +(right-left)/2;

            if(mid == 0 && nums[0] != nums[1])           //edge case when first element is single element
            {
                return nums[0];
            } 
            if(mid == n-1 && nums[n-1] != nums[n-2])     //edge case when last element is single element
            {
                return nums[n-1];
            }
            if(nums[mid] != nums[mid-1] && nums[mid] != nums[mid+1])
            {
                return nums[mid];
            }

            //reduce the search space
            if(mid % 2==0)                               //even number of left and right halves of mid
            {
                if(nums[mid] == nums[mid-1])             //single element is on the left side 
                {
                    right = mid-1;
                }
                else                                     //single element is on the right side 
                {
                    left = mid +1;
                }
            }
            else if( mid % 2 != 0)                       //odd number of left and right halves of mid
            {
                if(nums[mid] == nums[mid-1])            //single element is on the rightt side 
                {
                    left = mid +1;   
                }
                else                                    //single element is on the left side 
                {
                    right = mid-1;
                }
            }
        }
        return -1;
    }
}
